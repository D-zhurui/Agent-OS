{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "types": ["node"],          // 告诉 TS 加载 node 类型
    "typeRoots": ["./node_modules/@types"], // 可选，但默认已包含
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
